{
  "opacity": {
    "0": {
      "$type": "number",
      "$value": 0
    },
    "40": {
      "$type": "number",
      "$value": 0.4
    },
    "64": {
      "$type": "number",
      "$value": 0.64
    },
    "100": {
      "$type": "number",
      "$value": 1
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px",
        "color": "#18181b14"
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0px",
        "color": "#18181b1a"
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "0px",
        "color": "#18181b24"
      }
    }
  }
}
