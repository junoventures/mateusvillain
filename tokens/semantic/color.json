{
  "color": {
    "$type": "color",
    "background": {
      "default": { "$value": "{color.neutral.0}" },
      "subtle": { "$value": "{color.neutral.100}" }
    },
    "text": {
      "default": { "$value": "{color.neutral.900}" },
      "muted": { "$value": "{color.neutral.600}" },
      "on-action": { "$value": "{color.neutral.0}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.200}" }
    },
    "action": {
      "primary": {
        "default": { "$value": "{color.brand.600}" },
        "hover": { "$value": "{color.brand.700}" }
      },
      "secondary": {
        "default": { "$value": "{color.brand.100}" },
        "hover": { "$value": "{color.brand.300}" }
      },
      "danger": {
        "default": { "$value": "{color.red.500}" },
        "hover": { "$value": "{color.red.600}" }
      },
      "disabled": { "$value": "{color.neutral.200}" }
    },
    "focus": { "$value": "{color.brand.500}" }
  }
}
