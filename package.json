{
  "name": "@seu-usuario/ui",
  "version": "0.1.0",
  "description": "Biblioteca de componentes em HTML + CSS criada no workshop",
  "type": "module",
  "style": "dist/index.css",
  "exports": {
    ".": "./dist/index.css",
    "./index.css": "./dist/index.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "tokens": "style-dictionary build --config style-dictionary.config.js",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "mcp:penpot": "npx -y @penpot/mcp@latest",
    "build": "npm run tokens && npm run build:css",
    "build:css": "lightningcss --bundle src/index.css -o dist/index.css && lightningcss src/styles/tokens.css -o dist/tokens.css && cp src/styles/tokens.json dist/tokens.json",
    "build-storybook": "npm run tokens && storybook build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "design-system",
    "css",
    "design-tokens"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateusvillain/library.git"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/html-vite": "^10.6.7",
    "lightningcss-cli": "^1.33.0",
    "storybook": "^10.6.7",
    "style-dictionary": "^5.8.0",
    "vite": "^8.3.8"
  }
}
