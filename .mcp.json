{
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "penpot": {
      "type": "http",
      "url": "https://design.penpot.app/mcp/stream?userToken=${PENPOT_ACCESS_TOKEN}"
    },
    "storybook": {
      "type": "http",
      "url": "http://localhost:6006/mcp"
    },
    "magoo": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@acessibilidade/magoo-mcp@1.6.1"
      ]
    }
  }
}
